#!/bin/bash

# ZSH
ZSH=$HOME/.oh-my-zsh

# oh-my-posh's generated init script passes no --config to the per-prompt
# `print` calls -- it resolves the theme from a per-session cache file
# (~/.cache/oh-my-posh/zsh.$POSH_SESSION_ID.omp.cache) that only `init` writes.
# Every new shell's `init` prunes cache files older than the 7 day cache TTL, so
# a pane left idle that long loses its entry and silently falls back to
# oh-my-posh's built-in default theme until .zshrc is re-sourced. Pin --config on
# every render instead, so the prompt never depends on that cache. POSH_THEME is
# not honoured for this (ignored as of v29).
export OMP_CONFIG="$HOME/dotfiles/.config/ohmyposh/ryan.omp.json"
eval "$(oh-my-posh init zsh --config "$OMP_CONFIG")"
if (( $+functions[_omp_get_prompt] )); then
  functions -c _omp_get_prompt _omp_get_prompt_cached
  _omp_get_prompt() { _omp_get_prompt_cached "$@" --config="$OMP_CONFIG" }
fi
eval "$(zoxide init zsh)"

# export POSH_THEME="catppuccin_frappe"

# auto updating oh my zsh without prompt
DISABLE_UPDATE_PROMPT=true

export NVM_LAZY_LOAD=true
export NVM_COMPLETION=true

# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
plugins=(
  1password
  aliases
  brew
  extract
  gh
  git
  git-flow-avh
  history
  lando
  macos
  node
  npm
  nvm
  tig
  vscode
  web-search
  wp-cli
  # These last three need to be installed in ~/.oh-my-zsh/custom/plugins
  zsh-autosuggestions
  zsh-interactive-cd
  zsh-syntax-highlighting
)
