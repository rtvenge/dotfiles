#!/usr/bin/env zsh
# vim: ft=zsh

function gitflowsync() {
  git checkout main
  git push origin main
  git checkout develop
  git push origin develop
  git push origin --tags
}

function gitpushtomain() {
  git checkout dev
  git pull origin dev --no-edit
  git checkout main
  git pull origin main --no-edit
  git merge dev
  git push origin main
  git checkout dev
}

function npmbuild() {
  npm run build
  git commit -am "Adding compiled files."
}

function gitbranchcleanup() {
  git branch | grep -v " master$" | grep -v " main$" | grep -v " develop$" | grep -v " dev$" | xargs git branch -D
  git remote prune origin
}

# Troubleshoot load time
function timezsh() {
  local shell=${1-$SHELL}
  repeat 10 /usr/bin/time "$shell" -i -c exit
}

function fcd() {
  local dir
  dir=$(find "${1:-.}" -type d -not -path '*/\.*' 2>/dev/null | fzf +m) && cd "$dir" || return
}

function flushDNS() {
  sudo killall -HUP mDNSResponder
  sudo killall mDNSResponderHelper
  sudo dscacheutil -flushcache
}