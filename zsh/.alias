#!/bin/bash

#############
# My Alias' #
#############

alias edithosts='sudo vim /etc/hosts'
alias ipaddr="ifconfig |grep inet"
# if running "eza --git" throws an error, change alias
if command -v exa 1>/dev/null 2>&1; then
  alias l="eza -lah --icons"
else
  alias l="eza -lah --git --icons"
fi
alias ls="eza"
if command -v bat 1>/dev/null 2>&1; then
  alias cat="bat"
elif command -v batcat 1>/dev/null 2>&1; then
  alias cat="batcat"
fi
alias top="htop"
alias youtube-dl="yt-dlp"
alias lg="lazygit"
alias ld="lazydocker"