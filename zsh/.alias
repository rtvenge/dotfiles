#!/usr/bin/env zsh
# vim: ft=zsh

#############
# My Alias' #
#############

alias edithosts='sudo vim /etc/hosts'
alias ipaddr="ifconfig |grep inet"
# Use eza, else exa (Debian's exa may be built without --git), else plain ls,
# so `l` and `ls` work whichever is installed.
if command -v eza >/dev/null 2>&1; then
  alias l="eza -lah --git --icons"
  alias ls="eza"
elif command -v exa >/dev/null 2>&1; then
  alias l="exa -lah --icons"
  alias ls="exa"
else
  alias l="ls -lah"
fi
if command -v bat 1>/dev/null 2>&1; then
  alias cat="bat"
elif command -v batcat 1>/dev/null 2>&1; then
  alias cat="batcat"
fi
alias top="htop"
alias youtube-dl="yt-dlp"
alias lg="lazygit"
alias ld="lazydocker"
