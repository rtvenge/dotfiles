#!/usr/bin/env zsh
# vim: ft=zsh

#########################
# Environment Variables #
#########################

export PATH="$HOME/.lando/bin${PATH+:$PATH}" #landopath
export PATH="$HOME/.wp-cli/bin:$PATH"
export PATH="$HOME/.composer/vendor/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/vendor/bin:$PATH"
export EDITOR="nvim"
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

nvm use default >/dev/null 2>&1

# check if vscode is installed before exporting
if [ -d "/Applications/Visual Studio Code.app" ]; then
  export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
fi

# check if pyenv is installed before evaluating
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init --path)"
fi

fpath=(/usr/local/share/zsh-completions $fpath)

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export PATH="$HOME/.local/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Added by LM Studio CLI tool (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

# Extra PHP ini files for every Homebrew PHP version (leading ":" keeps each version's default conf.d).
# ~/.config/php/conf.d/99-hide-deprecations.ini hides deprecation notices in CLI tools like spinupwp.
export PHP_INI_SCAN_DIR=":$HOME/.config/php/conf.d"

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
# No compinit here: oh-my-zsh runs it after this file, and a second run slows startup.
fpath=($HOME/.docker/completions $fpath)
# End of Docker CLI completions