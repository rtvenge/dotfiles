#!/usr/bin/env bash
#
# herdr-site — open a folder in ~/Sites/lando as a herdr workspace using the Site
# starter layout (CLI / AI / Server), matching projects/site.toml.
#
# herdr-plus projects take a fixed working_dir — there is no prompt hook in the
# project loader — so the folder is chosen through the "Site" quick action
# instead, which is a `select` action whose options this script generates.
#
# Usage:
#   herdr-site <folder>    open ~/Sites/lando/<folder>
#   herdr-site --refresh   regenerate the quick action's folder list
#
# Opening a site also refreshes the list, so new folders show up next time.

set -euo pipefail

SITES_DIR="${HERDR_SITES_DIR:-$HOME/Sites/lando}"
ACTION_FILE="${HERDR_SITE_ACTION:-$HOME/.config/herdr/plugins/config/cloudmanic.herdr-plus/quick-actions/site.toml}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# One entry per tab, "<label><tab><startup command>". An empty command leaves the
# tab as a plain shell. Keep in sync with projects/site.toml.
TABS=(
	$'CLI\t'
	$'AI\tclaude'
	$'Server\tspinupwp sites:ssh'
)

die() {
	printf 'herdr-site: %s\n' "$*" >&2
	exit 1
}

# site_folders prints each site directory name, one per line. The trailing slash
# in the glob keeps it to directories while still matching symlinked sites.
site_folders() {
	local path name
	for path in "$SITES_DIR"/*/; do
		[[ -e $path ]] || continue
		name=$(basename "$path")
		[[ $name == .* ]] && continue
		printf '%s\n' "$name"
	done
}

# refresh_action rewrites the quick action so its options are the current site
# folders. Written to a temp file and moved into place so a half-written TOML is
# never visible to the picker.
refresh_action() {
	local tmp name pretty
	pretty="${SITES_DIR/#$HOME/\~}"
	tmp="$ACTION_FILE.tmp.$$"
	{
		printf '# Generated by %s --refresh — do not edit by hand.\n' "${SELF/#$HOME/\~}"
		printf '# Options are the folders in %s, regenerated each time a site is opened.\n\n' "$pretty"
		printf 'name = "Site"\n'
		printf 'description = "Open a %s site (CLI / AI / Server tabs)"\n' "$pretty"
		printf 'type = "select"\n'
		printf 'command = "%s {{.Value}}"\n' "$SELF"
		while IFS= read -r name; do
			printf '\n[[options]]\nlabel = "%s"\nvalue = "%s"\n' "$name" "$name"
		done < <(site_folders)
	} >"$tmp"
	mv "$tmp" "$ACTION_FILE"
}

# wait_for_prompt blocks until a freshly created pane has drawn its shell prompt.
# Typing into the gap before the shell is interactive drops the keystrokes, so
# the startup command would never run.
wait_for_prompt() {
	local pane=$1 i
	for ((i = 0; i < 50; i++)); do
		if [[ -n $(herdr pane read "$pane" --source visible --lines 5 2>/dev/null | tr -d '[:space:]') ]]; then
			return 0
		fi
		sleep 0.1
	done
}

open_site() {
	local site=$1 dir json ws root_tab pane entry label command i=0
	dir="$SITES_DIR/$site"
	[[ -d $dir ]] || die "no such site: $dir"

	# Set HERDR_SITE_NO_FOCUS=1 to build the workspace in the background instead
	# of switching to it (handy when scripting several at once).
	local focus=--focus
	[[ -n ${HERDR_SITE_NO_FOCUS-} ]] && focus=--no-focus

	json=$(herdr workspace create --cwd "$dir" --label "$site" "$focus")
	ws=$(jq -r '.result.workspace.workspace_id' <<<"$json")
	root_tab=$(jq -r '.result.tab.tab_id' <<<"$json")
	pane=$(jq -r '.result.root_pane.pane_id' <<<"$json")
	[[ -n $ws && $ws != null ]] || die "could not create workspace for $site"

	for entry in "${TABS[@]}"; do
		label=${entry%%$'\t'*}
		command=${entry#*$'\t'}

		# The first tab reuses the workspace's root tab; the rest are created
		# behind it, unfocused, so the workspace opens on tab one.
		if ((i == 0)); then
			herdr tab rename "$root_tab" "$label" >/dev/null
		else
			json=$(herdr tab create --workspace "$ws" --cwd "$dir" --label "$label" --no-focus)
			pane=$(jq -r '.result.root_pane.pane_id' <<<"$json")
		fi

		if [[ -n $command ]]; then
			wait_for_prompt "$pane"
			herdr pane run "$pane" "$command" >/dev/null
		fi
		i=$((i + 1))
	done
}

command -v herdr >/dev/null || die "herdr is not on PATH"
command -v jq >/dev/null || die "jq is required"
[[ -d $SITES_DIR ]] || die "sites directory not found: $SITES_DIR"

case "${1-}" in
	--refresh)
		refresh_action
		printf 'herdr-site: refreshed %s (%s sites)\n' "${ACTION_FILE/#$HOME/\~}" "$(site_folders | wc -l | tr -d ' ')"
		;;
	"" | -h | --help)
		printf 'usage: %s <folder>|--refresh\n\nsites in %s:\n' "$(basename "$SELF")" "${SITES_DIR/#$HOME/\~}"
		site_folders | column -c 100 2>/dev/null || site_folders
		;;
	*)
		open_site "$1"
		refresh_action || true
		;;
esac
