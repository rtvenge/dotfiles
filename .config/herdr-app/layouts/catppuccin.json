{
  "id": "root",
  "type": "row",
  "theme": {
    "light": "herdr-catppuccin-latte",
    "dark": "herdr-catppuccin"
  },
  "preview": "layouts/catppuccin.png",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "better-sidebar"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "better-sidebar",
                "props": {
                  "view": "agents"
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 37
          },
          "content": {
            "mod": "better-sidebar",
            "props": {
              "view": "footer"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs-graph"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "herdr-nvim-header",
                      "props": {
                        "replaces": {
                          "mod": "pane"
                        }
                      }
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 300
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "herdr-nvim",
                        "props": {
                          "replaces": {
                            "mod": "files"
                          },
                          "panel_width_was": {
                            "px": 368
                          },
                          "panel_width": 300
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "session-bar"
          }
        },
        {
          "id": "desktop-notifications",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "desktop-notifications"
          }
        }
      ]
    }
  ],
  "floating": [
    {
      "id": "herdr-nvim-sync",
      "content": {
        "mod": "herdr-nvim",
        "props": {
          "role": "sync"
        }
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}
