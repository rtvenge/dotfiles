{
  "proxy": "",
  "edit_predictions": {
    "mode": "eager",
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "api_url": "http://127.0.0.1:1234/v1/completions",
      "model": "qwen2.5-coder-1.5b",
      "prompt_format": "code_gemma",
      "max_output_tokens": 128
    }
  },
  "fullscreen_mode": "native",
  "show_edit_predictions": true,
  "disable_ai": false,
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
    "starts_open": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "file_finder": {
    "include_ignored": "smart"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "confirm",
      "tools": {}
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-5"
    },
    "model_parameters": []
  },
  "icon_theme": "Catppuccin Macchiato",
  "theme": "Catppuccin Macchiato",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "file_types": {
    "PHP": ["**/*.inc", "**/*.theme", "**/*.module"]
  },
  "git": {
    "blame": {
      "show_avatar": true
    }
  },
  "vim_mode": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "off",
  "languages": {
    "PHP": {
      "language_servers": [
        "phpcs",
        "!phpactor",
        "emmet-language-server"
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    },
    "Mustache": {
      "language_servers": [
        "html"
      ]
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "phpcs": {
      "settings": {
        "phpcs_path": "/Users/ryantvenge/.composer/vendor/bin/phpcs",
        "phpcbf_path": "/Users/ryantvenge/.composer/vendor/bin/phpcbf"
      }
    }
  },
  "tab_size": 2,
  "show_whitespaces": "all"
}