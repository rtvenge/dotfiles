[user]
	name = Ryan Tvenge
	email = ryan@hoverboardstudios.com
[core]
	editor = nvim
	fileMode = false
	excludesfile = ~/.gitignore_global
	pager = delta
# `git diff` itself is already formatted by delta, via core.pager above.
# These only apply to `git difftool` / `git mergetool`, which open a real
# side-by-side view -- delta is a pager, and read-only; it cannot resolve a
# merge conflict. nvimdiff is git built-in and matches core.editor.
# (Was Kaleidoscope until that was uninstalled, leaving both commands broken.)
[diff]
	tool = nvimdiff
	# Distinguishes moved lines from real add/deletes; delta renders it.
  colorMoved = default
[rerere]
  enabled = true
[merge]
	tool = nvimdiff
	# Shows the common ancestor in conflict markers, not just the two sides.
	# zdiff3 trims the shared lines out of the hunks; needs git >= 2.35 (2.53 here).
  conflictstyle = zdiff3
[delta]
  features = Catppuccin Mocha
[difftool]
	prompt = false
[mergetool]
	keepBackup = false
[url "https://"]
	insteadOf = git://
[push]
	default = simple
[pull]
	rebase = false
[alias]
	st = status --branch --short
	wat = log --graph --decorate --oneline -15
	co = checkout
	patch = add --patch
	unstage = reset --hard
	unstage-patch = reset HEAD --patch
	com = commit -m
	coma = commit -am
	devpull = pull origin develop:develop
	ocmitt = commit
	# Not working
	# cwp = commit -am "upgrading wordpress core/themes/plugins"
	amend = commit --amend --no-edit
	follow = log --follow -p
[help]
	autocorrect = 1
[interactive]
	diffFilter = delta --color-only
[color]
	ui = true
# The [color "diff-highlight"] and [color "diff"] blocks that used to live here
# were diff-so-fancy's recommended palette. delta does its own colouring and
# ignores diff-highlight entirely, so they were dead config -- see git history
# if the raw-git colours are ever wanted back.
[delta]
	# n/N jump between files and hunks; requires the pager to be delta.
	navigate = true
	line-numbers = true
	# Follows the terminal, so it stays right in Catppuccin Mocha.
	syntax-theme = base16

# Put this in your ~/.config/git/config file so your signingkey isn't in the repo.
# [user]
# 	name = Ryan Tvenge
# 	email = ryan@hoverboardstudios.com
# 	signingkey = "ssh-rsa ..."
# [gpg]
# 	format = ssh
# [gpg "ssh"]
# 	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
# [commit]
# 	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[safe]
	# Added because composer was complaining about changing branches on dev modules
	directory = *
[init]
	defaultBranch = main